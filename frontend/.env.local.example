# API Configuration
# For local development:
# NEXT_PUBLIC_API_URL=http://localhost:8000
# For production (Hugging Face):
NEXT_PUBLIC_API_URL=https://rrizwan98-ims.hf.space

# ChatKit Configuration (Phase 6)
# For local development:
# NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000/agent
# For production:
NEXT_PUBLIC_AGENT_API_URL=https://rrizwan98-ims.hf.space/agent

# OpenAI ChatKit Domain Key (required for production)
# Get your domain key from: https://platform.openai.com/settings/organization/security/domain-allowlist
# Leave empty for local development
NEXT_PUBLIC_CHATKIT_DOMAIN_KEY=your_domain_key_here

NEXT_PUBLIC_CHATKIT_THEME=light

# Optional: API Timeout (ms)
# NEXT_PUBLIC_API_TIMEOUT=30000

# Optional: Stock monitoring interval (ms)
# NEXT_PUBLIC_STOCK_MONITOR_INTERVAL=10000

# Optional: Retry configuration
# NEXT_PUBLIC_MAX_RETRIES=3
